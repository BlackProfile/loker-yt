generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Pengaturan situs disimpan sebagai key-value (value berisi JSON string)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Akun admin multi-user dengan role
model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("VIEWER") // OWNER | HR | VIEWER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Posisi lowongan yang dibuka — v3: fitur lengkap per lowongan
model Position {
  id           String        @id @default(cuid())
  title        String
  slug         String?       @unique // untuk URL deep link /?posisi=slug
  department   String        @default("Umum")
  type         String        @default("Remote")
  location     String        @default("Remote")
  description  String
  requirements String        @default("[]") // JSON string[]
  isActive     Boolean       @default(true)
  closesAt     DateTime? // auto-tutup setelah tanggal ini (opsional)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  // Tampilan & konten per lowongan
  coverFileId  String?
  coverFile    FileAsset?    @relation("coverFile", fields: [coverFileId], references: [id], onDelete: SetNull)
  salaryText   String? // teks bebas, mis. "Rp 3-5 juta/bulan"
  salaryVisible Boolean      @default(false)
  benefits     String        @default("[]") // JSON string[]
  examples     String        @default("[]") // JSON string[] URL contoh karya (YouTube/TikTok/IG)
  urgent       Boolean       @default(false) // badge "Urgent"
  featured     Boolean       @default(false) // pin di urutan atas

  // Formulir & screening per lowongan
  screeningQuestions String  @default("[]") // JSON {id,label,required}[]
  requireCv    Boolean       @default(false)
  requireIntro Boolean       @default(false)
  requirePortfolio Boolean   @default(false)
  maxApplicants Int? // kuota pelamar; null = tanpa kuota

  // Publikasi & jadwal
  publishAt    DateTime? // tayang otomatis setelah tanggal ini (terjadwal)

  // Pipeline & otomasi per lowongan
  stages               String  @default("[]") // JSON string[]; [] = pipeline default (5 status bawaan)
  aiCriteria           String? // kriteria AI khusus posisi (pelengkap prompt screening)
  autoShortlistScore   Int? // skor AI minimal untuk auto-shortlist
  autoShortlistStage   String? // tahap tujuan auto-shortlist (harus ada di stages posisi)
  applyTemplate        String? // template pesan konfirmasi lamaran ({nama},{posisi},{kode})
  acceptTemplate       String? // template pesan diterima
  rejectTemplate       String? // template pesan ditolak
  assignmentTitle      String? // tes/brief untuk pelamar posisi ini
  assignmentUrl        String?
  assignmentNote       String?

  // Evaluasi & kolaborasi tim
  rubricCriteria     String  @default("[]") // JSON string[] kriteria penilaian per lowongan
  checklistTemplate  String  @default("[]") // JSON string[] checklist evaluasi
  noteTemplates      String  @default("[]") // JSON string[] template catatan admin
  views              Int     @default(0) // jumlah view dialog detail (publik)
}

// Aset file yang diunggah pelamar (CV, audio intro)
model FileAsset {
  id             String        @id @default(cuid())
  filename       String
  mimeType       String
  size           Int
  path           String
  createdAt      DateTime      @default(now())
  cvApplications Application[] @relation("cvFile")
  introApp       Application[] @relation("introFile")
  coverPositions Position[]    @relation("coverFile")
}

// Lamaran yang masuk dari form publik
model Application {
  id               String     @id @default(cuid())
  name             String
  email            String
  phone            String
  positionId       String?
  position         Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  socialLinks      String?
  portfolioUrl     String?
  experience       String
  motivation       String
  status           String     @default("NEW") // tahap pipeline: 5 status bawaan ATAU tahap kustom per posisi
  adminNotes       String?
  trackingCode     String?    @unique // kode pelacakan untuk pelamar, mis. LM-ABC123
  rating           Int        @default(0) // 0-5 bintang dari admin
  tags             String     @default("[]") // JSON string[]
  interviewAt      DateTime? // jadwal wawancara
  talentPool       Boolean    @default(false)
  aiScore          Int? // 0-100 hasil screening AI
  aiSummary        String? // ringkasan AI
  aiRecommendation String? // rekomendasi AI (LAYAK_WAWANCARA | PERTIMBANGKAN | TIDAK_COCCOK)
  aiAnalyzedAt     DateTime?
  transcript       String? // hasil transkripsi ASR audio intro
  source           String? // jawaban "dari mana tahu lowongan ini"
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  screeningAnswers String? // JSON {questionId: jawaban}
  rubricScores     String? // JSON {kriteria: 1-5}
  checklistState   String  @default("[]") // JSON string[] item checklist yang dicentang
  cvFileId         String?
  cvFile           FileAsset? @relation("cvFile", fields: [cvFileId], references: [id], onDelete: SetNull)
  introFileId      String?
  introFile        FileAsset? @relation("introFile", fields: [introFileId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  activityLogs     ActivityLog[]
}

// Log aktivitas: audit admin + timeline per kandidat + riwayat notifikasi
model ActivityLog {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         String // nama aktor: "Sistem", "AI", nama admin, "Pelamar"
  action        String // mis. STATUS_CHANGE, NOTE, AI_SCREENING, WEBHOOK, UPLOAD, dll
  detail        String?
  createdAt     DateTime     @default(now())
}

// Email pelamar yang berlangganan notifikasi posisi baru
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
