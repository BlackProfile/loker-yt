generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Pengaturan situs disimpan sebagai key-value (value berisi JSON string)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Akun admin multi-user dengan role
model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("VIEWER") // OWNER | HR | VIEWER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Keamanan tambahan
  totpSecret        String? // secret TOTP (2FA) — null = belum diaktifkan
  totpEnabled       Boolean @default(false)
  assignedPositions String  @default("[]") // JSON string[] positionId — scope kandidat untuk HR (kosong = semua)

  // Alur undangan admin (set sandi via tautan email)
  inviteToken       String?  @unique // token undangan aktif — null = tidak ada undangan
  inviteExpiresAt   DateTime? // kedaluwarsa undangan (48 jam sejak dibuat)
}

// Posisi lowongan yang dibuka — v3: fitur lengkap per lowongan
model Position {
  id           String        @id @default(cuid())
  title        String
  slug         String?       @unique // untuk URL deep link /?posisi=slug
  department   String        @default("Umum")
  type         String        @default("Remote")
  location     String        @default("Remote")
  description  String

  // Mode kerja & lokasi terstruktur (fitur non-remote)
  workMode       String  @default("REMOTE") // REMOTE | ONSITE | HYBRID
  city           String? // kota kerja (untuk ONSITE/HYBRID)
  address        String? // alamat kantor lengkap (ONSITE/HYBRID)
  mapsUrl        String? // tautan Google Maps lokasi kantor
  workHours      String? // mis. "Senin-Jumat, 09.00-18.00 WIB"
  shiftSystem    String  @default("NONE") // NONE | FIXED | ROTATING
  facilities     String  @default("[]") // JSON string[] fasilitas (parkir, makan, transport)
  dailySlotQuota Int? // kuota slot wawancara on-site per hari (null = tanpa batas)
  requirements String        @default("[]") // JSON string[]
  isActive     Boolean       @default(true)
  closesAt     DateTime? // auto-tutup setelah tanggal ini (opsional)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  // Tampilan & konten per lowongan
  coverFileId  String?
  coverFile    FileAsset?    @relation("coverFile", fields: [coverFileId], references: [id], onDelete: SetNull)
  salaryText   String? // teks bebas, mis. "Rp 3-5 juta/bulan"
  salaryVisible Boolean      @default(false)
  benefits     String        @default("[]") // JSON string[] URL contoh karya (YouTube/TikTok/IG)
  examples     String        @default("[]") // JSON string[]
  urgent       Boolean       @default(false) // badge "Urgent"
  featured     Boolean       @default(false) // pin di urutan atas

  // Formulir & screening per lowongan
  screeningQuestions String  @default("[]") // JSON {id,label,required}[]
  requireCv    Boolean       @default(false)
  requireIntro Boolean       @default(false)
  requirePortfolio Boolean   @default(false)
  // NR-22 — sembunyikan slot opsional di wizard klasik (mis. supir/pembantu
  // tidak perlu CV/intro/portofolio/sosmed). Bidang wajib selalu menang.
  showCvField        Boolean @default(true) // tampilkan unggah CV (opsional)
  showIntroField     Boolean @default(true) // tampilkan unggah audio/video perkenalan (opsional)
  showPortfolioField Boolean @default(true) // tampilkan input link portofolio
  showSocialField    Boolean @default(true) // tampilkan input link sosial media
  customDocs   String        @default("[]") // JSON string[] label dokumen wajib tambahan dari pelamar
  maxApplicants Int? // kuota pelamar; null = tanpa kuota
  applyOpen    Boolean       @default(true) // formulir lamaran posisi ini buka/tutup (dikendalikan per posisi)
  // NR-24 — kolom opsional ekspektasi gaji di wizard (bisa disembunyikan per posisi)
  showExpectedSalary Boolean @default(true)
  // NR-32 — batas umur minimum pelamar (tahun, opsional) — peringatan halus di wizard
  minAge      Int?
  formSchema   String? // JSON FormSchema (Form Builder) — null = mode klasik (screeningQuestions/customDocs)

  // Publikasi & jadwal
  publishAt    DateTime? // tayang otomatis setelah tanggal ini (terjadwal)

  // Pipeline & otomasi per lowongan
  stages               String  @default("[]") // JSON string[]; [] = pipeline default (5 status bawaan)
  stageCategories      String  @default("{}") // JSON {"tahap kustom": "REVIEW"|"INTERVIEW"|"ACCEPTED"|"REJECTED"}
  stageNotes           String? // JSON {"tahap": "penjelasan untuk pelamar di halaman status"} — override teks bawaan
  stageWipLimits       String? // JSON {"tahap": maxKandidat} — batas kapasitas per tahap pipeline (null = tanpa batas)
  aiCriteria           String? // kriteria AI khusus posisi (pelengkap prompt screening)
  autoShortlistScore   Int? // skor AI minimal untuk auto-shortlist
  autoShortlistStage   String? // tahap tujuan auto-shortlist (harus ada di stages posisi)
  applyTemplate        String? // template pesan konfirmasi lamaran ({nama},{posisi},{kode})
  acceptTemplate       String? // template pesan diterima
  rejectTemplate       String? // template pesan ditolak
  assignmentTitle      String? // tes/brief untuk pelamar posisi ini
  assignmentUrl        String?
  assignmentNote       String?

  // Evaluasi & kolaborasi tim
  rubricCriteria     String  @default("[]") // JSON string[] kriteria penilaian per lowongan
  checklistTemplate  String  @default("[]") // JSON string[] checklist evaluasi
  noteTemplates      String  @default("[]") // JSON string[] template catatan admin
  views              Int     @default(0) // jumlah view dialog detail (publik)

  // Wawancara per lowongan (Zoom/Google Meet/onsite)
  interviewMode      String  @default("ONLINE") // mode default: ONLINE | ONSITE
  interviewPlatform  String  @default("GOOGLE_MEET") // platform default: GOOGLE_MEET | ZOOM | MICROSOFT_TEAMS | WHATSAPP | TELEPON | LAINNYA
  interviewDuration  Int     @default(45) // durasi default (menit)
  interviewCriteria  String  @default("[]") // JSON string[] kriteria scorecard wawancara
  interviewInviteTemplate String? // template pesan undangan ({nama},{posisi},{tanggal},{jam},{link},{mode})
  offerTemplate      String? // template pesan penawaran ({nama},{posisi},{gaji},{tanggal},{deadline})
  welcomeTemplate    String? // template pesan selamat datang ({nama},{posisi},{tanggal})

  // Offer & onboarding per lowongan
  probationMonths    Int     @default(3) // lama masa percobaan (bulan)
  onboardingDocs     String  @default("[]") // JSON string[] dokumen wajib onboarding
  reapplyCooldownDays Int    @default(0) // jeda minimal lamar ulang setelah ditolak (hari); 0 = bebas
  autoCloseOnHired   Boolean @default(true) // tandai kuota terpenuhi otomatis saat kandidat diterima

  // Rentang gaji wajar (validasi offer) — angka bulanan
  salaryMin Int?
  salaryMax Int?

  // Konten dua bahasa (ID default; EN opsional)
  titleEn        String?
  descriptionEn  String?
  requirementsEn String  @default("[]") // JSON string[]

  // Rencana ronde wawancara bawaan: JSON {round,name,mode?,platform?,durationMin?,interviewers?[]}[]
  roundPlan String @default("[]")

  // NR-22 — UI tersembunyi per posisi: JSON string[] kunci blok (lihat src/lib/hidden-ui.ts)
  hiddenUi String @default("[]")

  // Tong sampah (soft delete) — null = aktif
  deletedAt DateTime?

  interviewSlots InterviewSlot[]

  // Lanjutkan draft di perangkat lain (ide 5) & daftar tunggu posisi (ide 4)
  drafts   ApplicationDraft[] @relation("drafts")
  waitlist PositionWaitlist[] @relation("waitlist")
}

// Aset file yang diunggah pelamar (CV, audio intro)
model FileAsset {
  id             String        @id @default(cuid())
  filename       String
  mimeType       String
  size           Int
  path           String
  createdAt      DateTime      @default(now())
  cvApplications Application[] @relation("cvFile")
  introApp       Application[] @relation("introFile")
  coverPositions Position[]    @relation("coverFile")
}

// Lamaran yang masuk dari form publik
model Application {
  id               String     @id @default(cuid())
  name             String
  email            String
  phone            String
  positionId       String?
  position         Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  socialLinks      String?
  portfolioUrl     String?
  experience       String
  motivation       String
  status           String     @default("NEW") // tahap pipeline: 5 status bawaan ATAU tahap kustom per posisi
  adminNotes       String?
  trackingCode     String?    @unique // kode pelacakan untuk pelamar, mis. LM-ABC123
  rating           Int        @default(0) // 0-5 bintang dari admin
  tags             String     @default("[]") // JSON string[]
  interviewAt      DateTime? // jadwal wawancara
  talentPool       Boolean    @default(false)
  aiScore          Int? // 0-100 hasil screening AI
  aiSummary        String? // ringkasan AI
  aiRecommendation String? // rekomendasi AI (LAYAK_WAWANCARA | PERTIMBANGKAN | TIDAK_COCCOK)
  aiAnalyzedAt     DateTime?
  transcript       String? // hasil transkripsi ASR audio intro
  source           String? // jawaban "dari mana tahu lowongan ini"
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  screeningAnswers String? // JSON {questionId: jawaban}
  rubricScores     String? // JSON {kriteria: 1-5}
  checklistState   String  @default("[]") // JSON string[] item checklist yang dicentang
  cvFileId         String?
  cvFile           FileAsset? @relation("cvFile", fields: [cvFileId], references: [id], onDelete: SetNull)
  introFileId      String?
  introFile        FileAsset? @relation("introFile", fields: [introFileId], references: [id], onDelete: SetNull)
  extraDocs        String     @default("[]") // JSON {label,filename,fileId}[] dokumen wajib tambahan yang diunggah pelamar

  // Penolakan terstruktur (alasan + feedback ke pelamar)
  rejectionReason  String? // KUALIFIKASI | PENGALAMAN | PORTOFOLIO | KUOTA | TIDAK_HADIR | MENARIK_DIRI | TIDAK_RESPON | LAINNYA
  rejectionNote    String? // catatan/feedback penolakan (tampil ke pelamar bila mode feedback)
  rejectedAt       DateTime?

  // Penawaran (offer)
  offerStatus        String? // PENDING | ACCEPTED | DECLINED | EXPIRED; null = belum ada offer
  offerSalary        String? // teks bebas, mis. "Rp 4.500.000/bulan"
  offerType          String? // Full-time | Part-time | Freelance | Kontrak
  offerStartDate     DateTime?
  offerNote          String? // benefit tambahan / catatan offer
  offerDeadline      DateTime? // batas jawaban pelamar
  offerSentAt        DateTime?
  offerRespondedAt   DateTime?
  offerDeclineReason String?

  // Onboarding setelah diterima
  hiredAt          DateTime? // saat pelamar menerima penawaran
  probationEnd     DateTime? // akhir masa percobaan
  onboardingDocs   String    @default("[]") // JSON {id,label,required,done,fileId}[]

  // Rencana onboarding (agenda hari pertama, mentor, target): JSON {id,label,owner?,dueAt?,done}[]
  onboardingPlan String @default("[]")

  // Kualitas data & pelacakan sumber
  cvText        String? // teks hasil ekstraksi/OCR CV — dipakai pencarian semantik
  isDuplicate   Boolean @default(false) // terdeteksi lamaran ganda (email/CV sama)
  duplicateOfId String? // id lamaran pertama yang diduplikasi
  referrer      String? // URL halaman saat mengirim lamaran (sumber)

  // Task 27 — SLA, arsip, sampah, catatan video, persetujuan privasi
  stageUpdatedAt DateTime? // terakhir kali tahap pipeline berubah (untuk SLA per tahap)
  archivedAt     DateTime? // arsip otomatis/manual (lamaran stagnan) — null = tidak diarsip
  deletedAt      DateTime? // tong sampah (soft delete) — null = tidak terhapus
  videoNotes     String?   // JSON {t:detik,note:string}[] catatan bertimestamp saat review video intro
  consentAt      DateTime? // saat pelamar menyetujui pernyataan privasi di formulir

  // Info kehadiran untuk posisi non-remote (on-site/hybrid)
  domisili      String? // kota domisili pelamar
  komuterPlan   String? // SIAP_KOMUTER | PERLU_RELOKASI | TIDAK
  shiftPref     String? // PAGI | SIANG | MALAM | APA_SAJA
  startDatePref String? // perkiraan kapan bisa mulai kerja

  // NR-32 — data diri lengkap (terstruktur, opsional; diisi bila admin mengaktifkannya)
  nik        String?   // NIK 16 digit — payroll/kontrak
  birthDate  DateTime? // tanggal lahir — umur dihitung otomatis di admin

  // Bot Telegram — snooze & lampiran
  snoozeUntil DateTime? // bila diisi, bot mengingatkan admin pada waktu ini lalu membersihkannya
  botFiles    String    @default("[]") // JSON {fileId,filename,mimeType,size,sentAt}[] lampiran yang dikirim admin via bot Telegram

  // NR-24 — fitur per pelamar
  starredBy         String    @default("[]") // JSON string[] adminId — bintang personal per admin
  followUpAt        DateTime? // tanggal tindak lanjut (snooze) — muncul di Pusat Tugas saat jatuh tempo
  salaryExpectation Int? // ekspektasi gaji bulanan (rupiah) — dibandingkan dengan rentang gaji posisi
  holdAt            DateTime? // saat lamaran ditahan (HOLD)

  // NR-38 — mempermudah admin cek pelamar
  adminSeenAt       DateTime? // saat admin (siapa pun) pertama kali membuka dialog detail — dasar filter "Belum dilihat"
  screeningVerdicts String?   // JSON {questionId: "PASS"|"WARN"|"FAIL"} — penilaian admin per jawaban screening
  cvSummary         String?   // JSON {bullets: string[], generatedAt} — ringkasan CV otomatis (LLM atas cvText OCR)
  cvSummaryAt       DateTime? // waktu ringkasan CV terakhir dibuat — invalidasi bila CV diganti
  holdReason        String? // kode alasan hold: SLOT_PENUH | TUNGGU_KEPUTUSAN | MENUNGGU_DOKUMEN | LAINNYA
  holdNote          String? // catatan tambahan hold
  holdReviewAt      DateTime? // tanggal review kembali — masuk Pusat Tugas saat jatuh tempo
  docExpiries       String    @default("[]") // JSON {id,label,expiresAt}[] — masa berlaku dokumen (SIM/KTP/surat sehat)
  doNotHire         Boolean   @default(false) // bendera do-not-hire — lamaran baru dengan email/WA sama otomatis diberi peringatan
  doNotHireReason   String? // alasan do-not-hire (wajib saat memasang & melepas — pola kunci)
  mergedIntoId      String? // id lamaran utama bila lamaran ini digabungkan sebagai duplikat

  assessments  Assessment[]
  callLogs     CallLog[]
  internalDocs InternalDoc[]

  // NR-15 — transparansi & keterlibatan pelamar di halaman Cek Status
  stageHistory       String    @default("[]") // JSON {status,at}[] — riwayat tahap yang dilewati (urut waktu)
  candidateSeenAt    DateTime? // read receipt: terakhir pelamar membuka status lamaran ini
  candidateSeenCount Int       @default(0)  // berapa kali halaman status lamaran ini dibuka
  startConfirmedAt   DateTime? // pelamar mengonfirmasi tanggal mulai (setelah offer diterima)
  startProposedAt    DateTime? // usulan tanggal mulai baru dari pelamar
  startProposedNote  String?   // catatan singkat dari pelamar pada usulan tanggal

  // Task 30 — jawaban Form Builder per posisi (kunci fieldId stabil); null = lamaran mode klasik
  formAnswers    String?

  comments    Comment[]
  checkIns    CheckIn[]
  emailOut    EmailOutbox[]
  slotBooking InterviewSlot[] @relation("slotBooking")
  surveys     CandidateSurvey[] @relation("surveys")
  questions   ApplicationQuestion[]

  interviews       Interview[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  activityLogs     ActivityLog[]
}

// Sesi wawancara per lamaran — mendukung multi-ronde (HR, user, final).
model Interview {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round          Int         @default(1) // ronde ke-n
  mode           String      @default("ONLINE") // ONLINE | ONSITE
  platform       String      @default("GOOGLE_MEET") // GOOGLE_MEET | ZOOM | MICROSOFT_TEAMS | WHATSAPP | TELEPON | LAINNYA
  meetingLink    String? // link Zoom/Meet/Teams (untuk mode ONLINE)
  address        String? // lokasi (untuk mode ONSITE)
  scheduledAt    DateTime
  durationMin    Int         @default(45)
  interviewers   String      @default("[]") // JSON string[] nama pewawancara
  status         String      @default("SCHEDULED") // SCHEDULED | CONFIRMED | RESCHEDULE_REQUESTED | COMPLETED | NO_SHOW | CANCELLED

  // Hasil wawancara (scorecard)
  scores         String? // JSON {kriteria: 1-5}
  recommendation String? // LANJUT | CADANGAN | TOLAK
  notes          String?
  recordingUrl   String? // link rekaman Zoom/Meet (opsional)
  completedAt    DateTime?
  checkedInAt    DateTime? // saat kandidat ditandai hadir datang ke kantor (wawancara on-site)

  // Permintaan ubah jadwal dari pelamar
  rescheduleReason     String?
  rescheduleProposedAt DateTime?

  // Penanda reminder terkirim (oleh scheduler)
  reminderDaySent  Boolean @default(false)
  reminderHourSent Boolean @default(false)

  // Rekaman & transkrip wawancara
  transcript        String? // transkrip ASR dari rekaman
  transcriptSummary String? // ringkasan AI dari transkrip
  slotId            String? // slot self-service yang dipilih pelamar (bila ada)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([status])
}

// Log aktivitas: audit admin + timeline per kandidat + riwayat notifikasi
model ActivityLog {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         String // nama aktor: "Sistem", "AI", nama admin, "Pelamar"
  action        String // mis. STATUS_CHANGE, NOTE, AI_SCREENING, WEBHOOK, UPLOAD, dll
  detail        String?
  createdAt     DateTime     @default(now())
}

// Email pelamar yang berlangganan notifikasi posisi baru
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Diskusi internal antar admin pada satu kandidat
model Comment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorName    String
  authorRole    String      @default("HR") // OWNER | HR | VIEWER
  body          String
  mentions      String      @default("[]") // JSON string[] nama yang di-@mention
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// Pertanyaan pelamar dari halaman Cek Status ke tim rekrutmen (thread singkat).
// Pelamar bertanya (maks 500 karakter), admin menjawab; jawaban tampil di halaman status.
model ApplicationQuestion {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      String
  answer        String? // null = belum dijawab
  askedBy       String      @default("Pelamar") // nama pelamar pengirim
  answeredBy    String? // nama admin penjawab
  answeredAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// Pustaka template pesan global (lintas posisi)
model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("CUSTOM") // OFFER | REJECT | INVITE | CUSTOM
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notifikasi in-app untuk admin (ikon lonceng)
model NotificationItem {
  id            String   @id @default(cuid())
  title         String
  body          String?
  category      String   @default("SYSTEM") // SYSTEM | OFFER | INTERVIEW | APPLICATION | LOGIN
  applicationId String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([isRead])
}

// Jejak audit login admin (sukses/gagal + lockout brute force)
model LoginAudit {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  success   Boolean
  reason    String? // PASSWORD_SALAH | AKUN_NONAKTIF | TOTP_SALAH | LOCKOUT | OK
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([email])
}

// Slot jadwal wawancara yang dibuka admin — dipilih sendiri oleh pelamar
model InterviewSlot {
  id                    String       @id @default(cuid())
  positionId            String?
  position              Position?    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  scheduledAt           DateTime
  durationMin           Int          @default(45)
  mode                  String       @default("ONLINE")
  platform              String       @default("GOOGLE_MEET")
  meetingLink           String?
  address               String?
  interviewers          String       @default("[]") // JSON string[]
  bookedByApplicationId String?
  application           Application? @relation("slotBooking", fields: [bookedByApplicationId], references: [id], onDelete: SetNull)
  bookedAt              DateTime?
  createdAt             DateTime     @default(now())

  @@index([scheduledAt])
}

// Kotak keluar email (antrian email transaksional; terkirim bila SMTP terkonfigurasi)
model EmailOutbox {
  id            String       @id @default(cuid())
  toEmail       String
  subject       String
  body          String
  kind          String       @default("SYSTEM") // OFFER | REJECT | INVITE | REMINDER | SYSTEM
  status        String       @default("QUEUED") // QUEUED | SENT | FAILED | SKIPPED
  error         String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  sentAt        DateTime?

  @@index([status])
}

// Statistik drop-off per langkah wizard formulir lamaran (Task 27)
model FormStepStat {
  id         String   @id @default(cuid())
  positionId String?
  step       Int // nomor langkah wizard (1-based)
  event      String   @default("enter") // enter | advance | submit | abandon
  createdAt  DateTime @default(now())

  @@index([positionId])
  @@index([createdAt])
}

// Template formulir posisi — simpan konfigurasi lowongan untuk dipakai ulang (Task 27)
model PositionTemplate {
  id        String   @id @default(cuid())
  name      String
  note      String?
  data      String // JSON payload sebagian field Position (hasil sanitize position-input)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Papan pengumuman internal tim admin (Task 27)
model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  pinned     Boolean  @default(false)
  authorName String   @default("Admin")
  createdAt  DateTime @default(now())
}

// Endpoint webhook keluar generik — kirim event ke URL eksternal dengan tanda tangan HMAC (Task 27)
model WebhookEndpoint {
  id          String   @id @default(cuid())
  url         String
  secret      String
  events      String   @default("[\"*\"]") // JSON string[] nama event; ["*"] = semua event
  active      Boolean  @default(true)
  lastStatus  Int?
  lastFiredAt DateTime?
  failCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

// Sesi login admin aktif — mendukung daftar perangkat + logout paksa (Task 27)
model SessionToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // SHA-256 dari nilai cookie sesi
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime? // null = aktif

  @@index([userId])
}

// Cek-in masa percobaan 30/60/90 hari untuk karyawan baru
model CheckIn {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  day           Int // 30 | 60 | 90
  dueAt         DateTime?
  rating        Int? // 1-5
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// Draft lamaran lintas perangkat — pelamar mengirim tautan lanjutkan ke emailnya
// dari wizard (localStorage hanya lokal per perangkat). Token dipakai sekali via
// GET /api/public/apply-draft?token=... lalu baris dihapus (ide 5).
model ApplicationDraft {
  id         String    @id @default(cuid())
  token      String    @unique
  positionId String?
  position   Position? @relation("drafts", fields: [positionId], references: [id], onDelete: Cascade)
  email      String
  data       String // JSON isi draft wizard (jawaban per langkah)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
}

// Survei pengalaman kandidat 1 pertanyaan setelah keputusan (diterima/ditolak).
// Token unik dikirim lewat email status; jawaban direkap agregat di laporan (ide 7).
model CandidateSurvey {
  id            String       @id @default(cuid())
  token         String       @unique
  applicationId String?
  application   Application? @relation("surveys", fields: [applicationId], references: [id], onDelete: SetNull)
  score         Int // 1-5
  comment       String?
  createdAt     DateTime     @default(now())
}

// Daftar tunggu "Ingatkan saya bila dibuka lagi" pada posisi tutup/kuota penuh (ide 4).
model PositionWaitlist {
  id         String    @id @default(cuid())
  email      String
  positionId String?
  position   Position? @relation("waitlist", fields: [positionId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([email, positionId])
}

// Rekap bulanan otomatis — snapshot statistik bulan sebelumnya dibuat cron,
// ditampilkan & bisa dicetak PDF dari tab Laporan (ide 8).
model MonthlyReport {
  id        String   @id @default(cuid())
  month     String   @unique // format "YYYY-MM"
  data      String // JSON snapshot statistik
  createdAt DateTime @default(now())
}

// NR-24 — Tugas uji / assessment tracker per lamaran (mis. uji剪辑样片, tes berkendara).
model Assessment {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title           String // judul tugas uji
  note            String? // instruksi tambahan untuk pelamar
  dueAt           DateTime // tenggat pengumpulan
  status          String      @default("DIKIRIM") // DIKIRIM | DIKUMPUL | TERLAMBAT
  resultScore     Int? // nilai akhir 0-100 (dipakai bersama rubrik saat keputusan)
  resultNote      String? // catatan hasil penilaian
  submittedFileId String? // file hasil karya pelamar (FileAsset)
  completedAt     DateTime? // saat dikumpulkan/dinilai
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([applicationId])
}

// NR-24 — Log panggilan telepon per lamaran (saluran utama posisi on-site: Supir, POS, PRT).
model CallLog {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  outcome       String // DIANGKAT | TIDAK_DIANGKAT | JADWAL_ULANG | NOMOR_SALAH
  note          String? // ringkasan percakapan
  actor         String // nama admin yang mencatat
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// NR-24 — Dokumen internal khusus admin per lamaran (KTP, kontrak draft, hasil backcheck).
// Tidak pernah tampil di halaman status pelamar — terisolasi dari semua respons publik.
model InternalDoc {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  label         String // nama dokumen (mis. "KTP", "Kontrak draft")
  fileId        String // id FileAsset hasil unggahan
  uploadedBy    String // nama admin pengunggah
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}
